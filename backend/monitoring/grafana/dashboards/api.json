        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, endpoint, status) (rate(yalla_http_requests_total{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\",status=~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "{{status}} {{method}} {{endpoint}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
