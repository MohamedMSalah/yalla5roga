{
  "uid": "yalla-api-overview",
  "title": "Yalla 5roga API and Mobile",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "yalla5roga"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "yalla-prometheus"
        },
        "definition": "label_values(yalla_http_requests_total, environment)",
        "query": {
          "query": "label_values(yalla_http_requests_total, environment)",
          "refId": "variable-environment"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "endpoint",
        "label": "Endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "yalla-prometheus"
        },
        "definition": "label_values(yalla_http_requests_total, endpoint)",
        "query": {
          "query": "label_values(yalla_http_requests_total, endpoint)",
          "refId": "variable-endpoint"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "method",
        "label": "Method",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "yalla-prometheus"
        },
        "definition": "label_values(yalla_http_requests_total, method)",
        "query": {
          "query": "label_values(yalla_http_requests_total, method)",
          "refId": "variable-method"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "status",
        "label": "Status",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "yalla-prometheus"
        },
        "definition": "label_values(yalla_http_requests_total, status)",
        "query": {
          "query": "label_values(yalla_http_requests_total, status)",
          "refId": "variable-status"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total requests in range",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "yalla-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(yalla_http_requests_total{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__range]))",
          "legendFormat": "requests",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "yalla-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(yalla_http_requests_total{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__rate_interval]))",
          "legendFormat": "requests/s",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "sum(rate(yalla_http_requests_total{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__rate_interval])) * 60",
          "legendFormat": "requests/min",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Requests by endpoint",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "yalla-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, endpoint) (increase(yalla_http_requests_total{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__range]))",
          "legendFormat": "{{method}} {{endpoint}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "title": "Endpoint latency percentiles",
      "type": "timeseries",
      "description": "Minimum selected-range samples per endpoint are 50 for P50/P95 and 200 for P99. Histograms approximate percentiles.",
      "datasource": {
        "type": "prometheus",
        "uid": "yalla-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, method, endpoint) (rate(yalla_http_duration_seconds_bucket{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__rate_interval]))) and on (method, endpoint) (sum by (method, endpoint) (increase(yalla_http_duration_seconds_count{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__range])) >= 50)",
          "legendFormat": "P50 {{method}} {{endpoint}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, method, endpoint) (rate(yalla_http_duration_seconds_bucket{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__rate_interval]))) and on (method, endpoint) (sum by (method, endpoint) (increase(yalla_http_duration_seconds_count{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__range])) >= 50)",
          "legendFormat": "P95 {{method}} {{endpoint}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, method, endpoint) (rate(yalla_http_duration_seconds_bucket{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__rate_interval]))) and on (method, endpoint) (sum by (method, endpoint) (increase(yalla_http_duration_seconds_count{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__range])) >= 200)",
          "legendFormat": "P99 {{method}} {{endpoint}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "Slowest APIs by P95",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "yalla-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, method, endpoint) (rate(yalla_http_duration_seconds_bucket{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__rate_interval]))) and on (method, endpoint) (sum by (method, endpoint) (increase(yalla_http_duration_seconds_count{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__range])) >= 50))",
          "legendFormat": "{{method}} {{endpoint}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "title": "Client and server P95, sampled mobile",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "yalla-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method, endpoint) (rate(yalla_mobile_duration_seconds_bucket{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__rate_interval]))) and on (method, endpoint) (sum by (method, endpoint) (increase(yalla_mobile_duration_seconds_count{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__range])) >= 50)",
          "legendFormat": "client {{method}} {{endpoint}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, method, endpoint) (rate(yalla_mobile_server_header_seconds_bucket{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__rate_interval]))) and on (method, endpoint) (sum by (method, endpoint) (increase(yalla_mobile_server_header_seconds_count{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\",status=~\"$status\"}[$__range])) >= 50)",
          "legendFormat": "app header {{method}} {{endpoint}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "HTTP errors by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "yalla-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
