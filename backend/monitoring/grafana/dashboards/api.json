    {
      "id": 9,
      "title": "Potential duplicate request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "yalla-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
