          "refId": "A",
          "expr": "sum by (method, endpoint, trigger) (rate(yalla_http_potential_duplicates_total{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{endpoint}} {{trigger}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 10,
      "title": "Database calls per request",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "yalla-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, endpoint) (rate(yalla_http_db_operations_sum{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\"}[$__rate_interval])) / clamp_min(sum by (method, endpoint) (rate(yalla_http_db_operations_count{environment=~\"$environment\",endpoint=~\"$endpoint\",method=~\"$method\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{method}} {{endpoint}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
