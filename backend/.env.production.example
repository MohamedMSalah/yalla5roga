# Inject these settings from the deployment environment or secret manager.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# DATABASE_URL is the app connection. Include sslmode=require and a sized connection_limit.
# DIRECT_URL points to the same database via the direct endpoint for migration deployment.
DATABASE_URL=
DIRECT_URL=
CORS_ORIGINS=
# Exact trusted reverse-proxy addresses or CIDRs. Leave blank for direct binding.
TRUST_PROXY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=
APP_DOWNLOAD_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Optional gateway that exclusively permits the places/ prefix on the private bucket.
R2_PUBLIC_BASE_URL=
MONITORING_TOKEN=
OBSERVABILITY_ENABLED=1
OBS_MOBILE_TELEMETRY=0
LOG_LEVEL=info
PLACES_CURATOR_UIDS=
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GEOCODING_PROVIDER=
GEOCODING_BASE_URL=
GEOCODING_API_KEY=
