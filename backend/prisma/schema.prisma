enum departure_reminder_status {
  pending
  sent
}

model departure_reminder_preferences {
  user_id                     String   @id @db.VarChar(128)
  enabled                     Boolean  @default(false)
  preparation_buffer_minutes  Int      @default(10) @db.SmallInt
  updated_at                  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user                        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// One slot per user and outing for the personalized departure purpose.
model departure_reminders {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outing_id            String                    @db.Uuid
  user_id              String                    @db.VarChar(128)
  scheduled_send_at    DateTime                  @db.Timestamptz(6)
  estimate_reference   String                    @db.VarChar(128)
  input_fingerprint    String                    @db.Char(64)
  deduplication_key    String                    @unique @db.Char(64)
  duration_seconds     Int
  status               departure_reminder_status @default(pending)
  created_at           DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  sent_at              DateTime?                 @db.Timestamptz(6)
  user                 users                     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  outing               outings                   @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([outing_id, user_id])
  @@index([user_id])
  @@index([status, scheduled_send_at])
}

enum notification_channel {
  whatsapp
  push
  realtime
}

enum notification_event_status {
  pending
  processing
  sent
  failed
  dead
}

model notification_events {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type              notification_event_type
  channel           notification_channel         @default(push)
  status            notification_event_status    @default(pending)
  recipient_phone   String?                      @db.VarChar(16)
  recipient_user_id String?                      @db.VarChar(128)
  group_id          String?                      @db.Uuid
  invitation_id     String?                      @db.Uuid
  outing_id         String?                      @db.Uuid
  /// Idempotency key for outbox retries.
  event_key         String?                      @unique @db.VarChar(191)
  payload           Json
  attempts          Int                          @default(0) @db.SmallInt
  max_attempts      Int                          @default(5) @db.SmallInt
  next_attempt_at   DateTime                     @default(now()) @db.Timestamptz(6)
  last_error        String?                      @db.VarChar(1000)
  sent_at           DateTime?                    @db.Timestamptz(6)
  created_at        DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                     @default(now()) @updatedAt @db.Timestamptz(6)
  delivery_logs     notification_delivery_logs[]

  @@index([status, next_attempt_at], map: "idx_notification_events_claim")
  @@index([invitation_id], map: "idx_notification_events_invitation")
  @@index([group_id], map: "idx_notification_events_group")
  @@index([outing_id], map: "idx_notification_events_outing")
  @@index([recipient_phone], map: "idx_notification_events_phone")
}

model notification_delivery_logs {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id            String               @db.Uuid
  channel             notification_channel
  provider            String               @db.VarChar(40)
  provider_message_id String?              @db.VarChar(128)
  status              String               @db.VarChar(20)
  response            Json?
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  event               notification_events  @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([event_id], map: "idx_notification_delivery_logs_event")
}

// Opaque recovery secrets are stored only as SHA-256 digests.
/// Metadata rows for objects stored in Cloudflare R2. Only object keys and
/// metadata live in PostgreSQL — file binaries never touch the database.
/// `image_url` columns across entities may reference a row here via the
/// stable `media://<asset-id>` scheme resolved by clients to signed/public URLs.
model media_assets {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// R2 object key, unique per stored object. Keys are immutable per version:
  /// replacing an image uploads a new object with a new key.
  object_key        String           @unique @db.VarChar(512)
  /// R2 bucket name at confirm time (audit trail if the bucket is renamed).
  bucket            String           @db.VarChar(255)
  mime_type         String           @db.VarChar(100)
  /// Bytes reported by the uploader at request time; refreshed from R2 on confirm.
  file_size         Int
  /// public assets are served through the CDN base URL; private assets only
  /// through short-lived signed GET URLs.
  visibility        media_visibility @default(private)
  /// pending = upload URL issued; ready = object verified in R2;
  /// failed = object never appeared or verification failed.
  status            media_status     @default(pending)
  /// Creator/uploader. Always the Firebase UID of the Bearer token.
  owner_id          String           @db.VarChar(128)
  /// Purpose the upload was requested for; drives visibility and key layout.
  purpose           media_purpose
  /// Optional entity links set when the asset is attached to a record.
  user_id           String?          @db.VarChar(128)
  group_id          String?          @db.Uuid
  outing_id         String?          @db.Uuid
  place_id          String?          @db.Uuid
  users             users?           @relation("media_assets_owner", fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  linked_user       users?           @relation("media_assets_user", fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  linked_group      groups?          @relation(fields: [group_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  linked_outing     outings?         @relation(fields: [outing_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  linked_place      places?          @relation(fields: [place_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  /// When the uploaded object was verified in R2 (status became ready).
  verified_at       DateTime?        @db.Timestamptz(6)
  /// Upload URL expiry for pending rows; drives cleanup of orphan intents.
  upload_expires_at DateTime?        @db.Timestamptz(6)

  @@index([owner_id], map: "idx_media_assets_owner")
  @@index([status, upload_expires_at], map: "idx_media_assets_cleanup")
  @@index([user_id], map: "idx_media_assets_user")
  @@index([group_id], map: "idx_media_assets_group")
  @@index([outing_id], map: "idx_media_assets_outing")
  @@index([place_id], map: "idx_media_assets_place")
}

model password_recoveries {
  request_hash     String    @id @db.Char(64)
  user_id          String    @db.VarChar(128)
  phone            String    @db.VarChar(16)
  password_version String    @db.Char(64)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  expires_at       DateTime  @db.Timestamptz(6)
  proof_hash       String?   @unique @db.Char(64)
  reset_hash       String?   @unique @db.Char(64)
  consumed_at      DateTime? @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at])
}

model password_recovery_limits {
  key        String   @id @db.Char(64)
  attempts   Int
  expires_at DateTime @db.Timestamptz(6)

  @@index([expires_at])
}


model outing_voting_rounds {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outing_id    String @db.Uuid
  round_number Int
  starts_at    DateTime @default(now()) @db.Timestamptz(6)
  ends_at      DateTime? @db.Timestamptz(6)
  status       String @default("active") @db.VarChar(24)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  outing       outings @relation("OutingVotingRounds", fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  current_for  outings[] @relation("OutingCurrentRound")
  options      outing_voting_round_options[]
  @@unique([outing_id, round_number])
  @@index([status, ends_at])
}

model outing_voting_round_options {
  outing_id    String @db.Uuid
  round_number Int
  option_id    String @db.Uuid
  vote_count   Int @default(0)
  is_tied      Boolean @default(false)
  round        outing_voting_rounds @relation(fields: [outing_id, round_number], references: [outing_id, round_number], onDelete: Cascade, onUpdate: NoAction)
  option       outing_vote_options @relation(fields: [option_id, outing_id], references: [id, outing_id], onDelete: Cascade, onUpdate: NoAction)
  votes        outing_votes[]
  @@id([outing_id, round_number, option_id])
}
