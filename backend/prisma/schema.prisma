}

// Opaque recovery secrets are stored only as SHA-256 digests.
/// Metadata rows for objects stored in Cloudflare R2. Only object keys and
/// metadata live in PostgreSQL — file binaries never touch the database.
/// `image_url` columns across entities may reference a row here via the
/// stable `media://<asset-id>` scheme resolved by clients to signed/public URLs.
model media_assets {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// R2 object key, unique per stored object. Keys are immutable per version:
  /// replacing an image uploads a new object with a new key.
  object_key        String           @unique @db.VarChar(512)
  /// R2 bucket name at confirm time (audit trail if the bucket is renamed).
  bucket            String           @db.VarChar(255)
  mime_type         String           @db.VarChar(100)
  /// Bytes reported by the uploader at request time; refreshed from R2 on confirm.
  file_size         Int
  /// public assets are served through the CDN base URL; private assets only
  /// through short-lived signed GET URLs.
  visibility        media_visibility @default(private)
  /// pending = upload URL issued; ready = object verified in R2;
  /// failed = object never appeared or verification failed.
  status            media_status     @default(pending)
  /// Creator/uploader. Always the Firebase UID of the Bearer token.
  owner_id          String           @db.VarChar(128)
  /// Purpose the upload was requested for; drives visibility and key layout.
  purpose           media_purpose
  /// Optional entity links set when the asset is attached to a record.
  user_id           String?          @db.VarChar(128)
  group_id          String?          @db.Uuid
  outing_id         String?          @db.Uuid
  place_id          String?          @db.Uuid
  users             users?           @relation("media_assets_owner", fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  linked_user       users?           @relation("media_assets_user", fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  linked_group      groups?          @relation(fields: [group_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  linked_outing     outings?         @relation(fields: [outing_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  linked_place      places?          @relation(fields: [place_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  /// When the uploaded object was verified in R2 (status became ready).
  verified_at       DateTime?        @db.Timestamptz(6)
  /// Upload URL expiry for pending rows; drives cleanup of orphan intents.
  upload_expires_at DateTime?        @db.Timestamptz(6)

  @@index([owner_id], map: "idx_media_assets_owner")
  @@index([status, upload_expires_at], map: "idx_media_assets_cleanup")
  @@index([user_id], map: "idx_media_assets_user")
  @@index([group_id], map: "idx_media_assets_group")
  @@index([outing_id], map: "idx_media_assets_outing")
  @@index([place_id], map: "idx_media_assets_place")
}

