generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  starting_location_overrides       starting_location_overrides[]
  meetup_sessions                   meetup_sessions[]
  id                                String                @id @db.VarChar(128)
  name                              String                @db.VarChar(30)
  phone                             String                @unique @db.VarChar(16)
  password_hash                     String?               @db.VarChar(255)
  default_transportation_mode       transportation_mode?
  notification_preferences          Json                  @default("{}")
  departure_reminder_preferences    departure_reminder_preferences?
  departure_reminders               departure_reminders[]
  image_url                         String?               @db.VarChar(2048)
  created_at                        DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  place_reviews                     place_reviews[]
  place_review_reports              place_review_reports[]
  place_review_blocks_created       place_review_blocks[] @relation("place_review_block_viewer")
  place_review_blocks_received      place_review_blocks[] @relation("place_review_block_author")
  password_recoveries               password_recoveries[]
  chat_messages                     chat_messages[]
  chat_reads                        chat_reads[]
  group_members                     group_members[]
  groups                            groups[]
  notifications                     notifications[]
  outing_arrivals                   outing_arrivals[]
  outing_attendance                 outing_attendance[]
  outing_drafts                     outing_drafts[]
  outing_guests                     outing_guests[]
  outing_votes                      outing_votes[]
  outings_outings_created_byTousers outings[]             @relation("outings_created_byTousers")
  saved_outings                     saved_outings[]
  saved_places                      saved_places[]
  saved_locations                   saved_locations[]
  default_starting_location         default_starting_locations?
  location_privacy                  user_location_privacy?
  location_group_exclusions         user_location_group_exclusions[]
  user_fcm_tokens                   user_fcm_tokens[]
  group_invitations_sent            group_invitations[]   @relation("group_invitations_invited_by")
  group_invitations_received        group_invitations[]   @relation("group_invitations_user")
  media_assets_owned                media_assets[]        @relation("media_assets_owner")
  media_assets_linked               media_assets[]        @relation("media_assets_user")
}

model account_deletions {
  account_key  String                   @id @db.Char(64)
  firebase_uid String?                  @db.VarChar(128)
  firebase_disabled_at DateTime?        @db.Timestamptz(6)
  requested_at DateTime                 @default(now()) @db.Timestamptz(6)
  retry_after  DateTime                 @default(now()) @db.Timestamptz(6)
  completed_at DateTime?                @db.Timestamptz(6)
  media        account_deletion_media[]

  @@index([completed_at, retry_after], map: "idx_account_deletions_pending")
}

model account_deletion_media {
  account_key String            @db.Char(64)
  object_key  String            @db.VarChar(512)
  bucket      String            @db.VarChar(255)
  purpose     media_purpose
  visibility  media_visibility
  purge_after DateTime          @db.Timestamptz(6)
  deletion    account_deletions @relation(fields: [account_key], references: [account_key], onDelete: Cascade, onUpdate: NoAction)

  @@id([account_key, object_key])
}

model groups {
  meetup_sessions   meetup_sessions[]
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @db.VarChar(30)
  bio               String              @default("") @db.VarChar(160)
  image_url         String              @default("") @db.VarChar(2048)
  created_by        String              @db.VarChar(128)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  group_members     group_members[]
  group_invitations group_invitations[]
  location_exclusions user_location_group_exclusions[]
  users             users               @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notifications     notifications[]
  outing_drafts     outing_drafts[]
  outings           outings[]
  media_assets      media_assets[]

  @@index([created_by], map: "idx_groups_created_by")
}

model group_members {
  group_id  String     @db.Uuid
  user_id   String     @db.VarChar(128)
  role      group_role @default(member)
  joined_at DateTime   @default(now()) @db.Timestamptz(6)
  groups    groups     @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, user_id])
  @@index([user_id], map: "idx_group_members_user")
}

/// Phone invitation to a group. Pending rows are claimed only after Firebase
/// verifies invited_phone.
model group_invitations {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id           String            @db.Uuid
  invited_by_user_id String            @db.VarChar(128)
  invited_phone      String            @db.VarChar(16)
  user_id            String?           @db.VarChar(128)
  status             invitation_status @default(pending)
  expires_at         DateTime          @db.Timestamptz(6)
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  groups             groups            @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inviter            users             @relation("group_invitations_invited_by", fields: [invited_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitee            users?            @relation("group_invitations_user", fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([group_id], map: "idx_group_invitations_group")
  @@index([status], map: "idx_group_invitations_status")
  @@index([invited_phone, status], map: "idx_group_invitations_phone_status")
  @@index([user_id], map: "idx_group_invitations_user")
  @@index([invited_by_user_id], map: "idx_group_invitations_invited_by")
}

model places {
  brand_id            String?                @db.Uuid
  branch_name         String?                @db.VarChar(100)
  normalized_name     String                 @default("") @db.VarChar(200)
  normalized_address  String                 @default("") @db.VarChar(1000)
  brand               place_brands?          @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                 @db.VarChar(100)
  area                String                 @default("") @db.VarChar(100)
  vibe                outing_vibe            @default(food)
  description         String                 @default("") @db.VarChar(1000)
  cover_image_url     String                 @default("") @db.VarChar(2048)
  price_level         price_level?
  price_min           Decimal?               @db.Decimal(12, 2)
  price_max           Decimal?               @db.Decimal(12, 2)
  currency            String                 @default("EGP") @db.Char(3)
  latitude            Float?
  longitude           Float?
  featured            Boolean                @default(false)
  is_active           Boolean                @default(true)
  name_ar             String?                @db.VarChar(100)
  name_en             String?                @db.VarChar(100)
  category_id         String?                @db.VarChar(64)
  address             String?                @db.VarChar(1000)
  city                String?                @db.VarChar(100)
  district            String?                @db.VarChar(100)
  phone               String?                @db.VarChar(100)
  website             String?                @db.VarChar(2048)
  opening_hours       String?                @db.VarChar(1000)
  source              String                 @default("manual") @db.VarChar(16)
  source_id           String?                @db.VarChar(128)
  source_type         String?                @db.VarChar(16)
  status              String                 @default("active") @db.VarChar(32)
  last_synced_at      DateTime?              @db.Timestamptz(6)
  last_seen_at        DateTime?              @db.Timestamptz(6)
  missing_sync_count  Int                    @default(0)
  source_region       String?                @db.VarChar(16)
  source_tags         Json                   @default("{}")
  manually_managed    Boolean                @default(false)
  category            place_categories?      @relation(fields: [category_id], references: [id], onDelete: Restrict)
  place_vibes         place_vibes[]
  status_changes      place_status_changes[]
  created_at          DateTime               @default(now()) @db.Timestamptz(6)
  updated_at          DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  outing_vote_options outing_vote_options[]
  outings             outings[]
  place_hours         place_hours[]
  place_images        place_images[]
  place_prices        place_prices[]
  saved_places        saved_places[]
  saved_locations     saved_locations[]
  media_assets        media_assets[]
  source_records      place_source_records[]
  place_reviews       place_reviews[]
  rating_statistics   place_rating_statistics?
  meetup_recommendations meetup_recommendations[]

  @@unique([source, source_type, source_id], map: "places_source_identity_key")
  @@index([vibe], map: "idx_places_vibe")
  @@index([brand_id, status], map: "idx_places_brand_status")
  @@index([normalized_name], map: "idx_places_normalized_name")
  @@index([latitude, longitude], map: "idx_places_lat_lng")
  @@index([status, category_id], map: "idx_places_status_category")
  @@index([status, is_active, updated_at(sort: Desc), id], map: "idx_places_catalog_updated")
  @@index([category_id], map: "idx_places_category")
  @@index([source_region, source], map: "idx_places_region_source")
}

model place_catalog_changes {
  kind      String
  entity_id String
  revision  Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()"))

  @@id([kind, entity_id])
  @@index([revision, kind, entity_id], map: "idx_place_catalog_changes_revision")
}

model place_brands {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String @db.VarChar(100)
  normalized_name String @db.VarChar(200)
  identity_key    String? @unique @db.VarChar(160)
  description     String? @db.VarChar(1000)
  logo_url        String? @db.VarChar(2048)
  website         String? @db.VarChar(2048)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  branches        places[]
  aliases         place_brand_aliases[]
  @@index([normalized_name], map: "idx_place_brands_normalized_name")
}

model place_brand_aliases {
  brand_id        String @db.Uuid
  normalized_name String @db.VarChar(200)
  name            String @db.VarChar(100)
  brand           place_brands @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@id([brand_id, normalized_name])
  @@index([normalized_name], map: "idx_place_brand_alias_lookup")
}

model place_categories {
  updated_at  DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  id          String      @id @db.VarChar(64)
  name_en     String      @db.VarChar(100)
  name_ar     String      @db.VarChar(100)
  group_id    String      @db.VarChar(64)
  icon        String      @db.VarChar(64)
  legacy_vibe outing_vibe
  is_active   Boolean     @default(true)
  sort_order  Int         @default(0)
  places      places[]
  meetup_preferences meetup_preference_categories[]
}

model vibes {
  updated_at  DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  id          String        @id @db.VarChar(64)
  name_en     String        @db.VarChar(100)
  name_ar     String        @db.VarChar(100)
  icon        String        @db.VarChar(64)
  is_active   Boolean       @default(true)
  sort_order  Int           @default(0)
  place_vibes place_vibes[]
}

model place_vibes {
  place_id String @db.Uuid
  vibe_id  String @db.VarChar(64)
  source   String @default("manual") @db.VarChar(16)
  confidence Float?
  evidence Json @default("{}")
  place    places @relation(fields: [place_id], references: [id], onDelete: Restrict)
  vibe     vibes  @relation(fields: [vibe_id], references: [id], onDelete: Restrict)

  @@id([place_id, vibe_id])
  @@index([vibe_id, place_id], map: "idx_place_vibes_vibe")
}

model place_sync_runs {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  started_at     DateTime  @default(now()) @db.Timestamptz(6)
  completed_at   DateTime? @db.Timestamptz(6)
  status         String    @db.VarChar(32)
  imported_count Int       @default(0)
  updated_count  Int       @default(0)
  closed_count   Int       @default(0)
  skipped_count  Int       @default(0)
  failed_count   Int       @default(0)
  error_details  Json      @default("[]")
  dry_run        Boolean   @default(false)
  complete       Boolean   @default(false)
  coverage       Json      @default("{}")
  progress       Json      @default("{}")
  source         String    @default("osm") @db.VarChar(16)
  processed_count Int      @default(0)
  logs           place_sync_logs[]

  @@index([status, completed_at], map: "idx_place_sync_success")
  @@index([started_at], map: "idx_place_sync_started")
}

model place_sync_logs {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id String @db.Uuid
  level String @db.VarChar(16)
  code String @db.VarChar(64)
  source_id String? @db.VarChar(160)
  details Json @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  run place_sync_runs @relation(fields: [run_id], references: [id], onDelete: Restrict)
  @@index([run_id, created_at], map: "idx_place_sync_logs_run")
}

model place_source_records {
  source String @db.VarChar(16)
  source_type String @db.VarChar(16)
  source_id String @db.VarChar(128)
  place_id String @db.Uuid
  release String @db.VarChar(128)
  region String @db.VarChar(16)
  license String @db.VarChar(128)
  attribution String @db.VarChar(1000)
  evidence Json
  last_seen_at DateTime @default(now()) @db.Timestamptz(6)
  missing_count Int @default(0)
  last_absence_release String? @db.VarChar(128)
  place places @relation(fields: [place_id], references: [id], onDelete: Restrict)
  @@id([source, source_type, source_id])
  @@index([place_id], map: "idx_place_sources_place")
  @@index([source, region, last_seen_at], map: "idx_place_sources_coverage")
}

model place_sync_lock {
  id         String   @id @db.VarChar(32)
  token      String   @db.Uuid
  expires_at DateTime @db.Timestamptz(6)
}

model place_status_changes {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  place_id   String   @db.Uuid
  run_id     String?  @db.Uuid
  old_status String   @db.VarChar(32)
  new_status String   @db.VarChar(32)
  evidence   Json
  created_at DateTime @default(now()) @db.Timestamptz(6)
  place      places   @relation(fields: [place_id], references: [id], onDelete: Restrict)

  @@index([place_id, created_at], map: "idx_place_status_history")
}

model place_images {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  place_id   String  @db.Uuid
  image_url  String  @db.VarChar(2048)
  caption    String? @db.VarChar(200)
  sort_order Int     @default(0)
  source String @default("manual") @db.VarChar(16)
  license String? @db.VarChar(128)
  attribution String? @db.VarChar(1000)
  source_url String? @db.VarChar(2048)
  places     places  @relation(fields: [place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([place_id, sort_order], map: "idx_place_images_place")
}

model place_prices {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  place_id String  @db.Uuid
  label    String  @db.VarChar(80)
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("EGP") @db.Char(3)
  source String @default("manual") @db.VarChar(16)
  evidence Json @default("{}")
  places   places  @relation(fields: [place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([place_id], map: "idx_place_prices_place")
}

model place_hours {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  place_id  String    @db.Uuid
  day       weekday
  opens_at  DateTime? @db.Time(6)
  closes_at DateTime? @db.Time(6)
  is_closed Boolean   @default(false)
  source String @default("manual") @db.VarChar(16)
  expression String? @db.VarChar(1000)
  places    places    @relation(fields: [place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([place_id, day])
}

model outings {
  starting_location_overrides     starting_location_overrides[]
  travel_input_version            Int                   @default(1)
  departure_reminders             departure_reminders[]
  meetup_sessions                 meetup_sessions[]
  id                              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                           String                @db.VarChar(20)
  image_url                       String                @default("") @db.VarChar(2048)
  group_id                        String?               @db.Uuid
  create_request_key              String?               @db.VarChar(80)
  created_by                      String                @db.VarChar(128)
  status                          outing_status         @default(draft)
  /// Discriminator: group outing (requires group_id) vs special event (optional group; birthday/wedding/celebration/other).
  type                            outing_type           @default(group)
  occasion                        outing_occasion       @default(none)
  scheduled_at                    DateTime?             @db.Timestamptz(6)
  ends_at                         DateTime?             @db.Timestamptz(6)
  location_place_id               String?               @db.Uuid
  location_category_id            String?               @db.VarChar(64)
  location_address                String?               @db.VarChar(500)
  location_name                   String?               @db.VarChar(100)
  location_area                   String?               @db.VarChar(100)
  location_latitude               Float?
  location_longitude              Float?
  vote_deadline_hours             Int?                  @db.SmallInt
  vote_ends_at                    DateTime?             @db.Timestamptz(6)
  vote_closed_at                  DateTime?             @db.Timestamptz(6)
  vote_close_reason               vote_close_reason?
  current_voting_round             Int                   @default(1)
  resolution_method                String?               @db.VarChar(24)
  resolved_at                      DateTime?             @db.Timestamptz(6)
  voting_rounds                    outing_voting_rounds[] @relation("OutingVotingRounds")
  /// Winning candidate; must belong to this outing (enforced via composite FK).
  winning_option_id               String?               @db.Uuid
  created_at                      DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  chat_messages                   chat_messages[]
  chat_reads                      chat_reads[]
  notifications                   notifications[]
  outing_arrivals                 outing_arrivals[]
  outing_attendance               outing_attendance[]
  outing_guests                   outing_guests[]
  outing_vote_options             outing_vote_options[]
  outing_votes                    outing_votes[]
  current_round                   outing_voting_rounds   @relation("OutingCurrentRound", fields: [id, current_voting_round], references: [outing_id, round_number], onDelete: NoAction, onUpdate: NoAction, map: "outings_current_round_fkey")
  winning_option                  outing_vote_options?  @relation("outing_winning_option", fields: [winning_option_id, id], references: [id, outing_id], onDelete: NoAction, onUpdate: NoAction)
  users_outings_created_byTousers users                 @relation("outings_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groups                          groups?               @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  places                          places?               @relation(fields: [location_place_id], references: [id], onUpdate: NoAction)
  saved_outings                   saved_outings[]
  media_assets                    media_assets[]

  @@unique([created_by, create_request_key], map: "uq_outings_creator_request")
  @@index([group_id], map: "idx_outings_group")
  @@index([scheduled_at], map: "idx_outings_scheduled")
  @@index([created_by], map: "idx_outings_created_by")
  @@index([vote_ends_at], map: "idx_outings_vote_ends_at")
  @@index([status, vote_ends_at], map: "idx_outings_voting_deadline")
  @@index([location_place_id], map: "idx_outings_location_place")
}

/// Outing membership / invitation row.
/// Product roles are Owner (outings.created_by) and Member only.
/// `status` is invitation state: pending → accepted (Member) | declined.
model outing_guests {
  outing_id  String            @db.Uuid
  user_id    String            @db.VarChar(128)
  status     invitation_status @default(pending)
  invited_at DateTime          @default(now()) @db.Timestamptz(6)
  outings    outings           @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([outing_id, user_id])
  @@index([user_id], map: "idx_outing_guests_user")
  @@index([outing_id, status], map: "idx_outing_guests_status")
}

model outing_arrivals {
  outing_id             String   @db.Uuid
  user_id               String   @db.VarChar(128)
  arrived_at            DateTime @default(now()) @db.Timestamptz(6)
  verification_method   String   @default("legacy") @db.VarChar(24)
  verification_distance Float?
  location_accuracy     Float?
  outings               outings  @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([outing_id, user_id])
  @@index([user_id], map: "idx_outing_arrivals_user")
}

model outing_attendance {
  outing_id  String            @db.Uuid
  user_id    String            @db.VarChar(128)
  status     attendance_status
  updated_at DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  outings    outings           @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([outing_id, user_id])
  @@index([user_id], map: "idx_outing_attendance_user")
}

enum place_review_visibility {
  visible
  hidden
}

enum place_review_report_reason {
  spam
  harassment
  inappropriate
  off_topic
  other
}

enum place_review_report_status {
  open
  dismissed
  actioned
}

model place_reviews {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  place_id          String                  @db.Uuid
  user_id           String                  @db.VarChar(128)
  rating            Int
  review_text       String?                 @db.VarChar(1000)
  moderation_status place_review_visibility @default(visible)
  created_at        DateTime                @default(now()) @db.Timestamptz(3)
  updated_at        DateTime                @default(now()) @updatedAt @db.Timestamptz(3)
  place             places                  @relation(fields: [place_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user              users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reports           place_review_reports[]

  @@unique([place_id, user_id])
  @@index([place_id, moderation_status], map: "idx_place_reviews_visibility")
  @@index([place_id, created_at(sort: Desc), id(sort: Desc)], map: "idx_place_reviews_page")
  @@index([user_id], map: "idx_place_reviews_user")
}

model place_rating_statistics {
  place_id             String   @id @db.Uuid
  rating_sum           Int      @default(0)
  rating_count         Int      @default(0)
