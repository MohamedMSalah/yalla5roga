enum meetup_session_type {
  GROUP
  STANDALONE
}

enum meetup_session_status {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum meetup_calculation_status {
  ROUTING_UNAVAILABLE
  INSUFFICIENT_DATA
  QUEUED
  CALCULATING
  READY
  PARTIAL
  STALE
  FAILED
  NO_MATCHING_VENUES
}

enum meetup_optimization {
  BALANCED
  SHORTEST_TOTAL_TIME
}

enum travel_fairness_mode {
  BALANCED
  EQUAL_TRAVEL
  FASTEST_OVERALL
}

enum meetup_budget_level {
  AFFORDABLE
  MODERATE
  EXPENSIVE
}

enum meetup_optimization_priority {
  TOP_RATED
  BUDGET_FRIENDLY
  SHORTEST_DISTANCE
}

model meetup_sessions {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_type       meetup_session_type
  group_id           String?                  @db.Uuid
  outing_id          String?                  @db.Uuid
  created_by_user_id String                   @db.VarChar(128)
  status             meetup_session_status    @default(ACTIVE)
  calculation_status meetup_calculation_status @default(ROUTING_UNAVAILABLE)
  optimization       meetup_optimization      @default(BALANCED)
  input_version      Int                      @default(1)
  input_digest       String?                  @db.Char(64)
  created_at         DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  expires_at         DateTime                 @db.Timestamptz(6)
  group              groups?                  @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  outing             outings?                 @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator            users                    @relation(fields: [created_by_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  manual_participants meetup_manual_participants[]
  starting_location_overrides starting_location_overrides[]
  preferences         meetup_preferences?
  calculations        meetup_calculations[]

  @@index([group_id, status])
  @@index([created_by_user_id])
  @@index([outing_id])
  @@index([expires_at])
}

model meetup_calculations {
  id                            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetup_session_id             String @db.Uuid
  input_version                 Int
  attempt                       Int
  calculation_status            meetup_calculation_status
  input_fingerprint             String @db.Char(64)
  intended_participant_count    Int
  included_participant_count    Int
  unavailable_participant_count Int
  is_partial                    Boolean
  optimization_policy_version   String @db.VarChar(32)
  calculated_at                 DateTime? @db.Timestamptz(6)
  expires_at                    DateTime? @db.Timestamptz(6)
  created_at                    DateTime @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  safe_failure_code             String? @db.VarChar(64)
  candidate_place_ids           String[] @default([]) @db.Uuid
  session                       meetup_sessions @relation(fields: [meetup_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recommendations               meetup_recommendations[]

  @@unique([meetup_session_id, input_version, attempt], map: "meetup_calculations_version_attempt_key")
  @@index([calculation_status, expires_at])
  @@index([candidate_place_ids], type: Gin, map: "meetup_calculations_candidate_places_idx")
}

model meetup_recommendations {
  id                      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calculation_id          String @db.Uuid
  place_id                String @db.Uuid
  rank                    Int
  average_duration_seconds Float?
  maximum_duration_seconds Int?
  total_duration_seconds   Int?
  minimum_duration_seconds Int?
  total_distance_meters    Float?
  duration_spread_seconds  Int?
  fairness_score           Float?
  match_score              Float?
  explanation_codes        String[] @default([])
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  calculation              meetup_calculations @relation(fields: [calculation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  place                    places @relation(fields: [place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([calculation_id, place_id])
  @@unique([calculation_id, rank])
  @@index([place_id])
}

model meetup_preferences {
  meetup_session_id               String @id @db.Uuid
  travel_fairness_mode            travel_fairness_mode @default(BALANCED)
  selected_budget_levels          meetup_budget_level[] @default([])
  minimum_rating                  Decimal? @db.Decimal(2, 1)
  maximum_travel_duration_seconds Int?
  additional_priorities           meetup_optimization_priority[] @default([])
  planned_meetup_at               DateTime? @db.Timestamptz(6)
  require_open_at_meetup_time      Boolean @default(false)
  updated_at                      DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  meetup_session                  meetup_sessions @relation(fields: [meetup_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categories                      meetup_preference_categories[]
}

model meetup_preference_categories {
  meetup_session_id String @db.Uuid
  category_id       String @db.VarChar(64)
  preferences       meetup_preferences @relation(fields: [meetup_session_id], references: [meetup_session_id], onDelete: Cascade, onUpdate: NoAction)
  category          place_categories @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@id([meetup_session_id, category_id])
  @@index([category_id])
}

model meetup_manual_participants {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetup_session_id   String               @db.Uuid
  display_name        String?              @db.VarChar(60)
  approximate_area    String?              @db.VarChar(96)
  latitude            Float
  longitude           Float
  transportation_mode transportation_mode?
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  meetup_session      meetup_sessions      @relation(fields: [meetup_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([meetup_session_id])
}

