# Neon pooled URL for the API. Leave out channel_binding — Prisma closes
# the connection when that parameter is present.
# postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
PORT=3000
# Bind address for Express. Use 0.0.0.0 so physical devices on the LAN can reach the API.
# Prefer 127.0.0.1 only when you intentionally want localhost-only access.
HOST=0.0.0.0
NODE_ENV=development

# Firebase Admin SDK (service account) — must match the Flutter Firebase project
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client SDK Web API key — used by POST /api/auth/login and /api/auth/signup
# Usually the same value as Flutter FIREBASE_ANDROID_API_KEY / Web API key
FIREBASE_API_KEY=

# --- Group invite notifications (WhatsApp + Flutter deep links) ---
# HTTPS base used in WhatsApp messages, e.g. https://yalla5roga.com/invite/{id}
INVITE_DEEP_LINK_BASE=https://yalla5roga.com
APP_DOWNLOAD_URL=https://yalla5roga.com
# Custom scheme handled by Flutter (yalla5roga://invite?invitationId=...&groupId=...)
FLUTTER_APP_SCHEME=yalla5roga

# Outbox worker (DB-backed queue; no Redis required)
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_MAX_ATTEMPTS=5

# WhatsApp channel: stub (local/dev log) | meta (Cloud API send)
WHATSAPP_PROVIDER=stub
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved Meta template: body params = inviter name, group name, deep link
WHATSAPP_INVITE_TEMPLATE=group_invite
WHATSAPP_INVITE_TEMPLATE_LANG=en

# Flutter (yalla_5roga) — copy flutter/.env.example to flutter/.env, then:
#   flutter run --dart-define-from-file=.env
# Android emulator API_BASE_URL=http://10.0.2.2:3000
# iOS simulator / desktop API_BASE_URL=http://localhost:3000
# Physical device API_BASE_URL=http://<LAN-IP>:3000
# Production Flutter builds require https API_BASE_URL.
