# Neon pooled URL for the API. Leave out channel_binding — Prisma closes
# the connection when that parameter is present.
# postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
PORT=3000
# Bind address for Express. Use 0.0.0.0 so physical devices on the LAN can reach the API.
# Prefer 127.0.0.1 only when you intentionally want localhost-only access.
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated browser origins. Native Flutter clients do not send Origin.
# Required in production, for example: https://app.yalla5roga.com
CORS_ORIGINS=

# Firebase Admin SDK (service account) — must match the Flutter Firebase project
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client SDK Web API key — used by POST /api/auth/login and /api/auth/signup
# Usually the same value as Flutter FIREBASE_ANDROID_API_KEY / Web API key
FIREBASE_API_KEY=

# --- Group invite notifications (WhatsApp + Flutter deep links) ---
# HTTPS base used in WhatsApp messages, e.g. https://yalla5roga.com/invite/{id}
INVITE_DEEP_LINK_BASE=https://yalla5roga.com
APP_DOWNLOAD_URL=https://yalla5roga.com
# Custom scheme handled by Flutter (yalla5roga://invite?invitationId=...&groupId=...)
FLUTTER_APP_SCHEME=yalla5roga

# Outbox worker (DB-backed queue; no Redis required)
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_MAX_ATTEMPTS=5

# WhatsApp channel: stub (local/dev log) | meta (Cloud API send)
WHATSAPP_PROVIDER=stub
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved Meta template: body params = inviter name, group name, deep link
WHATSAPP_INVITE_TEMPLATE=group_invite
WHATSAPP_INVITE_TEMPLATE_LANG=en

# Flutter (yalla_5roga) — copy flutter/.env.example to flutter/.env, then:
#   flutter run --dart-define-from-file=.env
# Android emulator API_BASE_URL=http://10.0.2.2:3000
# iOS simulator / desktop API_BASE_URL=http://localhost:3000
# Physical device API_BASE_URL=http://<LAN-IP>:3000
# Production Flutter builds require https API_BASE_URL.

# Meta-approved template with title, Cairo date/time, venue, calendar URL, and app URL.
WHATSAPP_SPECIAL_EVENT_TEMPLATE=special_event_invite

# Optional geocoding. Use a Pelias-compatible HTTPS service.
# Confirm provider quota, attribution and storage terms before enabling.
GEOCODING_PROVIDER=
GEOCODING_BASE_URL=
GEOCODING_API_KEY=
GEOCODING_ATTRIBUTION=
GEOCODING_REQUESTS_PER_MINUTE=60
GEOCODING_CACHE_SECONDS=0

# --- Place catalog curation ---
# Comma-separated Firebase UIDs allowed to create/update/delete places,
# opening hours, images, and prices. Reads stay public. Fails closed when empty,
# so ordinary authenticated users receive 403 for catalog writes.
PLACES_CURATOR_UIDS=

# Actual attendance controls
OUTING_ARRIVAL_RADIUS_METERS=100
OUTING_ARRIVAL_MAX_ACCURACY_METERS=50
OUTING_ARRIVAL_WINDOW_MINUTES=360

# --- Media storage (Cloudflare R2, S3-compatible API) ---
# Leave R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET_NAME
# empty to keep the in-process mock adapter for local development. Real R2
# uploads stay disabled until every credential below is configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional jurisdiction hint for R2 buckets outside the default region.
R2_JURISDICTION=
# Public CDN custom domain bound to the R2 bucket. Placeholder until Cloudflare
# provides the real domain — public place images use it; private images never do.
R2_PUBLIC_BASE_URL=https://media.example.com
# Presigned PUT/GET lifetimes and upload policy.
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
# Orphan cleanup: pending upload intents expire after this many minutes.
MEDIA_PENDING_TTL_MINUTES=1440
MEDIA_CLEANUP_INTERVAL_MS=3600000
# Base URL the mock adapter's local upload/download routes advertise.
# Physical devices need the LAN IP, e.g. http://192.168.1.20:3000
MEDIA_MOCK_BASE_URL=http://localhost:3000
