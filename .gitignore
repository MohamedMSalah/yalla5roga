# Secrets. Example env files stay tracked.
.env
.env.*
!.env.example

# Backend environment secrets
/backend/.env
/backend/.env.*
!/backend/.env.example

*.pem
*.p12
*.pfx
*.jks
*.keystore
**/key.properties
**/*firebase-adminsdk*.json
**/*serviceAccount*.json
**/*service-account*.json

# Backend generated output
backend/node_modules/
backend/dist/

# Flutter / Dart generated output
flutter/.dart_tool/
flutter/.flutter-plugins
flutter/.flutter-plugins-dependencies
flutter/.pub-cache/
flutter/.pub/
flutter/build/
flutter/coverage/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
*.log
