generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                                          String              @id @db.VarChar(128)
  name                                        String              @db.VarChar(30)
  phone                                       String?             @unique @db.VarChar(16)
  /// Retained for existing accounts during the phone-auth transition; never exposed by Prisma.
  email                                       String?             @unique @ignore @db.VarChar(254)
  /// bcrypt hash for phone/password accounts.
  password_hash                               String?             @db.VarChar(255)
  password_updated_at                         DateTime?           @db.Timestamptz(6)
  image_url                                   String?             @db.VarChar(2048)
  created_at                                  DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  chat_messages                               chat_messages[]
  chat_reads                                  chat_reads[]
  group_members                               group_members[]
  groups                                      groups[]
  notifications                               notifications[]
  outing_arrivals                           outing_arrivals[]
  outing_attendance                           outing_attendance[]
  outing_drafts                               outing_drafts[]
  outing_guests                               outing_guests[]
  outing_votes                                outing_votes[]
  outings_outings_created_byTousers           outings[]           @relation("outings_created_byTousers")
  outings_outings_suggested_by_user_idTousers outings[]           @relation("outings_suggested_by_user_idTousers")
  saved_outings                               saved_outings[]
  saved_places                                saved_places[]
  user_fcm_tokens                             user_fcm_tokens[]
  group_invitations_sent                      group_invitations[] @relation("group_invitations_invited_by")
  group_invitations_received                  group_invitations[] @relation("group_invitations_user")
}

model groups {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @db.VarChar(30)
  bio               String              @default("") @db.VarChar(160)
  image_url         String              @default("") @db.VarChar(2048)
  created_by        String              @db.VarChar(128)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  group_members     group_members[]
  group_invitations group_invitations[]
  users             users               @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notifications     notifications[]
  outing_drafts     outing_drafts[]
  outings           outings[]

  @@index([created_by], map: "idx_groups_created_by")
}

model group_members {
  group_id  String     @db.Uuid
  user_id   String     @db.VarChar(128)
  role      group_role @default(member)
  joined_at DateTime   @default(now()) @db.Timestamptz(6)
  groups    groups     @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, user_id])
  @@index([user_id], map: "idx_group_members_user")
}

/// Phone invitation to a group. Pending rows are claimed only after Firebase
/// verifies invited_phone.
model group_invitations {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id           String            @db.Uuid
  invited_by_user_id String            @db.VarChar(128)
  invited_phone      String            @db.VarChar(16)
  user_id            String?           @db.VarChar(128)
  status             invitation_status @default(pending)
  expires_at         DateTime          @db.Timestamptz(6)
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  groups             groups            @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inviter            users             @relation("group_invitations_invited_by", fields: [invited_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitee            users?            @relation("group_invitations_user", fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([group_id], map: "idx_group_invitations_group")
  @@index([invited_phone], map: "idx_group_invitations_phone")
  @@index([status], map: "idx_group_invitations_status")
  @@index([invited_phone, status], map: "idx_group_invitations_phone_status")
  @@index([user_id], map: "idx_group_invitations_user")
  @@index([invited_by_user_id], map: "idx_group_invitations_invited_by")
}

model places {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @db.VarChar(100)
  area                String                @default("") @db.VarChar(100)
  vibe                outing_vibe           @default(food)
  description         String                @default("") @db.VarChar(1000)
  cover_image_url     String                @default("") @db.VarChar(2048)
  price_level         price_level           @default(moderate)
  price_min           Decimal?              @db.Decimal(12, 2)
  price_max           Decimal?              @db.Decimal(12, 2)
  currency            String                @default("EGP") @db.Char(3)
  latitude            Float?
  longitude           Float?
  featured            Boolean               @default(false)
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  outing_vote_options outing_vote_options[]
  outings             outings[]
  place_hours         place_hours[]
  place_images        place_images[]
  place_prices        place_prices[]
  saved_places        saved_places[]

  @@index([vibe], map: "idx_places_vibe")
  @@index([latitude, longitude], map: "idx_places_lat_lng")
}

model place_images {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  place_id   String  @db.Uuid
  image_url  String  @db.VarChar(2048)
  caption    String? @db.VarChar(200)
  sort_order Int     @default(0)
  places     places  @relation(fields: [place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([place_id, sort_order], map: "idx_place_images_place")
}

model place_prices {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  place_id String  @db.Uuid
  label    String  @db.VarChar(80)
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("EGP") @db.Char(3)
  places   places  @relation(fields: [place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([place_id], map: "idx_place_prices_place")
}

model place_hours {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  place_id  String    @db.Uuid
  day       weekday
  opens_at  DateTime? @db.Time(6)
  closes_at DateTime? @db.Time(6)
  is_closed Boolean   @default(false)
  places    places    @relation(fields: [place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([place_id, day])
}

model outings {
  id                                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                                     String                @db.VarChar(20)
  image_url                                 String                @default("") @db.VarChar(2048)
  group_id                                  String?               @db.Uuid
  create_request_key                        String?               @db.VarChar(80)
  created_by                                String                @db.VarChar(128)
  status                                    outing_status         @default(draft)
  /// Discriminator: group outing (requires group_id) vs special event (birthday/wedding).
  type                                      outing_type           @default(group)
  occasion                                  outing_occasion       @default(none)
  scheduled_at                              DateTime?             @db.Timestamptz(6)
  ends_at                                   DateTime?             @db.Timestamptz(6)
  location_place_id                         String?               @db.Uuid
  location_name                             String?               @db.VarChar(100)
  location_area                             String?               @db.VarChar(100)
  location_latitude                         Float?
  location_longitude                        Float?
  vote_deadline_hours                       Int?                  @db.SmallInt
  vote_ends_at                              DateTime?             @db.Timestamptz(6)
  vote_closed_at                            DateTime?             @db.Timestamptz(6)
  vote_close_reason                         vote_close_reason?
  /// Winning candidate; must belong to this outing (enforced via composite FK).
  winning_option_id                         String?               @db.Uuid
  suggested_by_user_id                      String?               @db.VarChar(128)
  created_at                                DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  chat_messages                             chat_messages[]
  chat_reads                                chat_reads[]
  notifications                             notifications[]
  outing_arrivals                           outing_arrivals[]
  outing_attendance                         outing_attendance[]
  outing_guests                             outing_guests[]
  outing_vote_options                       outing_vote_options[]
  outing_votes                              outing_votes[]
  winning_option                            outing_vote_options?  @relation("outing_winning_option", fields: [winning_option_id, id], references: [id, outing_id], onDelete: NoAction, onUpdate: NoAction)
  users_outings_created_byTousers           users                 @relation("outings_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groups                                    groups?               @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  places                                    places?               @relation(fields: [location_place_id], references: [id], onUpdate: NoAction)
  users_outings_suggested_by_user_idTousers users?                @relation("outings_suggested_by_user_idTousers", fields: [suggested_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  saved_outings                             saved_outings[]

  @@unique([created_by, create_request_key], map: "uq_outings_creator_request")
  @@index([status], map: "idx_outings_status")
  @@index([group_id], map: "idx_outings_group")
  @@index([scheduled_at], map: "idx_outings_scheduled")
  @@index([created_by], map: "idx_outings_created_by")
  @@index([vote_ends_at], map: "idx_outings_vote_ends_at")
  @@index([status, vote_ends_at], map: "idx_outings_voting_deadline")
  @@index([suggested_by_user_id], map: "idx_outings_suggested_by")
  @@index([location_place_id], map: "idx_outings_location_place")
}

/// Outing membership / invitation row.
/// Product roles are Owner (outings.created_by) and Member only.
/// `status` is invitation state: pending → accepted (Member) | declined.
model outing_guests {
  outing_id  String            @db.Uuid
  user_id    String            @db.VarChar(128)
  status     invitation_status @default(accepted)
  invited_at DateTime          @default(now()) @db.Timestamptz(6)
  outings    outings           @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([outing_id, user_id])
  @@index([user_id], map: "idx_outing_attendance_user")
  @@index([user_id], map: "idx_outing_guests_user")
  @@index([outing_id, status], map: "idx_outing_guests_status")
}

model outing_arrivals {
  outing_id  String   @db.Uuid
  user_id    String   @db.VarChar(128)
  arrived_at DateTime @default(now()) @db.Timestamptz(6)
  outings    outings  @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([outing_id, user_id])
  @@index([user_id], map: "idx_outing_arrivals_user")
}

model outing_attendance {
  outing_id  String            @db.Uuid
  user_id    String            @db.VarChar(128)
  status     attendance_status
  updated_at DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  outings    outings           @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([outing_id, user_id])
}

model outing_vote_options {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outing_id      String         @db.Uuid
  place_id       String?        @db.Uuid
  label          String         @db.VarChar(100)
  area           String         @default("") @db.VarChar(100)
  image_url      String         @default("") @db.VarChar(2048)
  vibe           outing_vibe    @default(food)
  latitude       Float?
  longitude      Float?
  sort_order     Int            @default(0)
  outings        outings        @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  places         places?        @relation(fields: [place_id], references: [id], onUpdate: NoAction)
  outing_votes   outing_votes[]
  winning_for    outings[]      @relation("outing_winning_option")

  @@unique([outing_id, place_id])
  @@unique([id, outing_id], map: "uq_vote_options_id_outing")
  @@index([place_id], map: "idx_outing_vote_options_place")
}

/// One active place vote per user per outing. Changing a vote updates this row.
model outing_votes {
  outing_id           String              @db.Uuid
  user_id             String              @db.VarChar(128)
  option_id           String              @db.Uuid
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  outing_vote_options outing_vote_options @relation(fields: [option_id, outing_id], references: [id, outing_id], onDelete: Cascade, onUpdate: NoAction)
  outings             outings             @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users               users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([outing_id, user_id])
  @@index([option_id], map: "idx_outing_votes_option")
  @@index([user_id], map: "idx_outing_votes_user")
}

model outing_drafts {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String          @db.VarChar(128)
  title               String          @default("") @db.VarChar(20)
  image_url           String          @default("") @db.VarChar(2048)
  group_id            String?         @db.Uuid
  occasion            outing_occasion @default(none)
  special_event       Boolean         @default(false)
  vibe                outing_vibe     @default(food)
  scheduled_date      DateTime?       @db.Date
  scheduled_hour      Int?            @db.SmallInt
  scheduled_minute    Int?            @db.SmallInt
  location_name       String?         @db.VarChar(100)
  location_area       String?         @db.VarChar(100)
  location_latitude   Float?
  location_longitude  Float?
  let_vote            Boolean         @default(false)
  vote_deadline_hours Int?            @db.SmallInt
  guest_ids           Json            @default("[]")
  selected_places     Json            @default("[]")
  updated_at          DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  groups              groups?         @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  users               users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_outing_drafts_user")
}

model chat_messages {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outing_id         String                  @db.Uuid
  sender_id         String                  @db.VarChar(128)
  text              String                  @db.VarChar(2000)
  sent_at           DateTime                @default(now()) @db.Timestamptz(6)
  client_message_id String?                 @db.Uuid
  outings           outings                 @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users                   @relation(fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([outing_id, sender_id, client_message_id], map: "uq_chat_messages_client_msg")
  @@index([outing_id, sent_at(sort: Desc)], map: "idx_chat_messages_outing_sent")
  @@index([outing_id, sent_at(sort: Desc), id(sort: Desc)], map: "idx_chat_messages_outing_sent_id")
  @@index([sender_id], map: "idx_chat_messages_sender")
}

model chat_reads {
  outing_id    String   @db.Uuid
  user_id      String   @db.VarChar(128)
  last_read_at DateTime @default(now()) @db.Timestamptz(6)
  outings      outings  @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([outing_id, user_id])
  @@index([user_id], map: "idx_chat_reads_user")
}

model notifications {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String            @db.VarChar(128)
  body            String            @db.VarChar(500)
  image_url       String?           @db.VarChar(2048)
  type            notification_type @default(system)
  outing_id       String?           @db.Uuid
  group_id        String?           @db.Uuid
  action_required Boolean           @default(false)
  is_read         Boolean           @default(false)
  /// Idempotency key so retries do not duplicate in-app notifications.
  event_key       String?           @unique @db.VarChar(191)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  groups          groups?           @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  outings         outings?          @relation(fields: [outing_id], references: [id], onUpdate: NoAction)
  users           users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_notifications_user_created")
  @@index([outing_id], map: "idx_notifications_outing")
  @@index([group_id], map: "idx_notifications_group")
}

model user_fcm_tokens {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.VarChar(128)
  token      String   @db.VarChar(512)
  platform   String?  @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, token])
  @@unique([token], map: "uq_user_fcm_tokens_token")
}

model saved_outings {
  user_id   String   @db.VarChar(128)
  outing_id String   @db.Uuid
  saved_at  DateTime @default(now()) @db.Timestamptz(6)
  outings   outings  @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, outing_id])
  @@index([outing_id], map: "idx_saved_outings_outing")
}

model saved_places {
  user_id  String   @db.VarChar(128)
  place_id String   @db.Uuid
  saved_at DateTime @default(now()) @db.Timestamptz(6)
  places   places   @relation(fields: [place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users    users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, place_id])
  @@index([place_id], map: "idx_saved_places_place")
}

enum attendance_status {
  going
  not_going
  maybe
}

enum group_role {
  owner
  member
}

enum notification_type {
  outing
  group
  chat
  vote
  invitation
  system
}

enum outing_occasion {
  none
  birthday
  wedding
}

enum outing_type {
  group
  special_event
}

enum outing_status {
  draft
  voting
  confirmed
  cancelled
  past
}

enum vote_close_reason {
  all_voted
  deadline
  unique_winner
  tie_break
  zero_votes
}

enum outing_vibe {
  food
  activity
  outdoor
  movie
}

enum price_level {
  free
  budget
  moderate
  expensive
  luxury
}

enum weekday {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum invitation_status {
  pending
  accepted
  declined
  expired
  revoked
}

enum notification_event_type {
  group_invite
  outing_invite
  outing_updated
  attendance_changed
  chat_message
  voting_closed_early
  voting_deadline_reached
  winner_selected
  tie_break_selected
  outing_confirmed
  outing_cancelled
}

enum notification_channel {
  whatsapp
  push
  sms
  email
}

enum notification_event_status {
  pending
  processing
  sent
  failed
  dead
}

model notification_events {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                notification_event_type
  channel             notification_channel        @default(push)
  status              notification_event_status   @default(pending)
  recipient_phone     String?                     @db.VarChar(16)
  recipient_user_id   String?                     @db.VarChar(128)
  group_id            String?                     @db.Uuid
  invitation_id       String?                     @db.Uuid
  outing_id           String?                     @db.Uuid
  /// Idempotency key for outbox retries.
  event_key           String?                     @unique @db.VarChar(191)
  payload             Json
  attempts            Int                         @default(0) @db.SmallInt
  max_attempts        Int                         @default(5) @db.SmallInt
  next_attempt_at     DateTime                    @default(now()) @db.Timestamptz(6)
  last_error          String?                     @db.VarChar(1000)
  sent_at             DateTime?                   @db.Timestamptz(6)
  created_at          DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)
  delivery_logs       notification_delivery_logs[]

  @@index([status, next_attempt_at], map: "idx_notification_events_claim")
  @@index([invitation_id], map: "idx_notification_events_invitation")
  @@index([group_id], map: "idx_notification_events_group")
  @@index([outing_id], map: "idx_notification_events_outing")
  @@index([recipient_phone], map: "idx_notification_events_phone")
}

model notification_delivery_logs {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id            String               @db.Uuid
  channel             notification_channel
  provider            String               @db.VarChar(40)
  provider_message_id String?              @db.VarChar(128)
  status              String               @db.VarChar(20)
  response            Json?
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  event               notification_events  @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([event_id], map: "idx_notification_delivery_logs_event")
}
