# Flutter client configuration.
# Copy this file to .env and load it at compile time:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# Do NOT put database passwords, JWT signing secrets, service-account JSON,
# or privileged backend tokens here. Those belong on the Node.js API.
# Values compiled into the client can be extracted from the binary.

# development | staging | production
# Required for release/profile builds. Debug defaults to development.
APP_ENV=development

# Android emulator -> host machine: http://10.0.2.2:3000
# iOS simulator / desktop:          http://localhost:3000
# Physical device:                  http://<LAN-IP>:3000
# Production must be https and a public host (no localhost / 10.0.2.2).
API_BASE_URL=http://10.0.2.2:3000

API_CONNECT_TIMEOUT_MS=30000
API_RECEIVE_TIMEOUT_MS=30000

# Public geocoding / map tile endpoints (no API key). Prefer proxying
# Nominatim through the backend if usage grows.
NOMINATIM_HOST=nominatim.openstreetmap.org
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

APP_DOWNLOAD_URL=https://yalla5roga.com

# Firebase client identifiers from FlutterFire / the Firebase console.
# Required. Leave blank here; copy real values into the gitignored .env.
# Restrict these keys in Google Cloud. Never add Admin SDK credentials.
FIREBASE_ANDROID_API_KEY=
FIREBASE_IOS_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=com.example.yalla5roga
# iOS OAuth client ID from GoogleService-Info.plist CLIENT_ID.
FIREBASE_IOS_CLIENT_ID=
# Web OAuth client ID (client_type 3). Used as Google Sign-In serverClientId.
FIREBASE_WEB_CLIENT_ID=
