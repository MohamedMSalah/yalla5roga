# Physical-device development config (gitignored when copied to .env.device).
# Prefer generating this file with:
#   pwsh ../scripts/dev-physical-android.ps1 -PrepareOnly
# Or from the flutter/ directory after the script writes .env.device:
#   flutter run -d <deviceId> --dart-define-from-file=.env.device
#
# Do NOT put database passwords, JWT signing secrets, or Admin SDK credentials here.

# development | staging | production
APP_ENV=development

# Must be the PC's current LAN IPv4 (not localhost / 10.0.2.2).
# Replace via the helper script — do not commit a real IP.
API_BASE_URL=http://REPLACE_WITH_LAN_IP:3000

API_CONNECT_TIMEOUT_MS=30000
API_RECEIVE_TIMEOUT_MS=30000

NOMINATIM_HOST=nominatim.openstreetmap.org
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

APP_DOWNLOAD_URL=https://yalla5roga.com

# Copy Firebase client identifiers from your local gitignored .env
FIREBASE_ANDROID_API_KEY=
FIREBASE_IOS_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=com.example.yalla5roga
FIREBASE_IOS_CLIENT_ID=
FIREBASE_WEB_CLIENT_ID=
